{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-param-reassign": [
      "error",
      {
        "props": false
      }
    ],
    "consistent-return": "warn",
    "func-names": "off",
    "object-shorthand": "warn",
    "prefer-arrow-callback": "warn",
    "no-plusplus": "off",
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "no-await-in-loop": "warn",
    "no-restricted-globals": ["error", "isNaN"],
    "no-return-await": "off",
    "global-require": "warn"
  }
}
