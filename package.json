{
  "name": "times-gates",
  "version": "3.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --coverage --testPathIgnorePatterns=games",
    "test:watch": "jest --watch --testPathIgnorePatterns=games",
    "test:games": "echo 'Games tests skipped - shared dev/prod database' && exit 0",
    "test:all": "npm run test",
    "lint": "eslint . --ext .js --ignore-pattern node_modules",
    "lint:fix": "eslint . --ext .js --ignore-pattern node_modules --fix"
  },
  "keywords": [
    "valorant",
    "api",
    "rank-tracker",
    "divoon",
    "games",
    "portfolio"
  ],
  "author": "DiamondStalker (Carlos)",
  "license": "ISC",
  "description": "Divoon API - Multi-purpose API for gaming, portfolio management, and Valorant rank tracking",
  "dependencies": {
    "axios": "^1.7.9",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
